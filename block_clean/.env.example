# Leave these blank to use the local JSON store in data/db.json.
# Fill them in to store cases, shops, and the leaderboard in Elasticsearch.
ELASTIC_ENDPOINT=https://your-deployment.es.region.aws.elastic-cloud.com
ELASTIC_API_KEY=

# Used once, to create the mistral-embeddings inference endpoint on the cluster.
# After that, semantic search talks only to Elasticsearch.
MISTRAL_API_KEY=

# Email is optional. With neither key set, notes are appended to data/outbox.jsonl.
# RESEND_API_KEY=
# EMAIL_FROM=Block Clean <cleanup@yourdomain.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=

# Used as the link in the shop email. Defaults to http://127.0.0.1:8000
# PUBLIC_BASE_URL=http://127.0.0.1:8000
